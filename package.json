{
  "name": "devc-vscode",
  "displayName": "Dev Container File Tree",
  "description": "Browse and edit files inside a running dev container (devcontainer CLI / Docker) from VS Code running on the host.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onFileSystem:devc-vscode",
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Dev Container File Tree",
      "properties": {
        "devc-vscode.dockerPath": {
          "type": "string",
          "default": "docker",
          "description": "Docker CLI command used to talk to containers (a name on PATH or an absolute path)."
        }
      }
    },
    "commands": [
      {
        "command": "devc-vscode.openContainerFolder",
        "title": "Open Folder in Dev Container...",
        "category": "Dev Container FS"
      },
      {
        "command": "devc-vscode.refresh",
        "title": "Refresh Container Files",
        "category": "Dev Container FS"
      },
      {
        "command": "devc-vscode.openInDevContainer",
        "title": "Open in Dev Container",
        "category": "Dev Container FS"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "devc-vscode.openInDevContainer",
          "when": "explorerResourceIsFolder"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.138.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
