{
  "name": "devc-vscode",
  "displayName": "Dev Container File Tree",
  "description": "Browse and edit files inside a running dev container (devcontainer CLI / Docker) from VS Code running on the host.",
  "repository": {
    "type": "git",
    "url": "https://github.com/devc-tools/devc-vscode.git"
  },
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onFileSystem:devc-vscode",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Dev Container File Tree",
      "properties": {
        "devc-vscode.dockerPath": {
          "type": "string",
          "default": "docker",
          "description": "Docker CLI command used to talk to containers (a name on PATH or an absolute path)."
        },
        "devc-vscode.openFolderCommand": {
          "type": "string",
          "default": "devc herdr",
          "description": "Command sent to the terminal by \"Open Folder in Container\"."
        }
      }
    },
    "commands": [
      {
        "command": "devc-vscode.refresh",
        "title": "Refresh Container Files",
        "category": "Dev Container FS",
        "icon": "$(refresh)"
      },
      {
        "command": "devc-vscode.openFolderInContainer",
        "title": "Open Folder in Container",
        "category": "Dev Container FS"
      },
      {
        "command": "devc-vscode.newFile",
        "title": "New File",
        "category": "Dev Container FS"
      },
      {
        "command": "devc-vscode.newFolder",
        "title": "New Folder",
        "category": "Dev Container FS"
      },
      {
        "command": "devc-vscode.rename",
        "title": "Rename",
        "category": "Dev Container FS"
      },
      {
        "command": "devc-vscode.delete",
        "title": "Delete",
        "category": "Dev Container FS"
      },
      {
        "command": "devc-vscode.copyPath",
        "title": "Copy Container Path",
        "category": "Dev Container FS"
      },
      {
        "command": "devc-vscode.focusAgent",
        "title": "Focus Agent",
        "category": "Dev Container FS"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "devc-vscode.refresh",
          "when": "view == devc-vscode.containers",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "devc-vscode.newFile",
          "when": "view == devc-vscode.containers && viewItem =~ /^(container|directory)$/",
          "group": "1_new"
        },
        {
          "command": "devc-vscode.newFolder",
          "when": "view == devc-vscode.containers && viewItem =~ /^(container|directory)$/",
          "group": "1_new@2"
        },
        {
          "command": "devc-vscode.rename",
          "when": "view == devc-vscode.containers && viewItem != container",
          "group": "2_edit"
        },
        {
          "command": "devc-vscode.delete",
          "when": "view == devc-vscode.containers && viewItem != container",
          "group": "2_edit@2"
        },
        {
          "command": "devc-vscode.copyPath",
          "when": "view == devc-vscode.containers",
          "group": "3_copy"
        }
      ],
      "explorer/context": [
        {
          "command": "devc-vscode.openFolderInContainer",
          "when": "explorerResourceIsFolder && resourceScheme != devc-vscode"
        }
      ],
      "commandPalette": [
        {
          "command": "devc-vscode.focusAgent",
          "when": "false"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "devc-vscode.containers",
          "name": "Dev Containers"
        },
        {
          "id": "devc-vscode.agents",
          "name": "Dev Container Agents"
        }
      ]
    },
    "keybindings": [
      {
        "command": "devc-vscode.rename",
        "key": "f2",
        "when": "view == devc-vscode.containers && listFocus && !inputFocus"
      },
      {
        "command": "devc-vscode.delete",
        "key": "delete",
        "when": "view == devc-vscode.containers && listFocus && !inputFocus"
      }
    ],
    "viewsWelcome": [
      {
        "view": "devc-vscode.agents",
        "contents": "No agents detected. Agents running in herdr inside this workspace's dev containers appear here."
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "package:dev": "npx vsce package -o devc-vscode-dev.vsix && code --install-extension devc-vscode-dev.vsix",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.138.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "@xterm/headless": "^6.0.0"
  }
}
