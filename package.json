        "category": "Dev Container FS",
        "icon": "$(filter-filled)"
      },
      {
        "command": "devc-vscode.showWorkspacesOnly",
        "title": "Show Only /workspaces",
        "category": "Dev Container FS",
        "icon": "$(filter)"
      },
      {
        "command": "devc-vscode.openFolderInContainer",
        "title": "Open Folder in Container",
        "category": "Dev Container FS"
      },
      {
        "command": "devc-vscode.attachTerminal",
        "title": "Attach Terminal",
        "category": "Dev Container FS",
        "icon": "$(terminal)"
      },
      {
        "command": "devc-vscode.addSshHost",
        "title": "Add SSH Host…",
        "category": "Dev Container FS",
        "icon": "$(add)"
      },
      {
        "command": "devc-vscode.focusFeatures",
        "title": "Focus Features…",
        "category": "Dev Container FS"
      },
      {
        "command": "devc-vscode.focusActiveAgents",
        "title": "Focus on Active Agents",
        "category": "Dev Container FS"
      },
      {
        "command": "devc-vscode.openFeatureSpace",
        "title": "Open herdr Space for Feature…",
        "category": "Dev Container FS"
      },
      {
        "command": "devc-vscode.addSpaceFolder",
        "title": "Add Active herdr Space to Workspace",
        "category": "Dev Container FS"
      },
      {
        "command": "devc-vscode.sendToSshHost",
        "title": "Send to SSH Host…",
        "category": "Dev Container FS"
      },
      {
        "command": "devc-vscode.fetchFromSshHost",
        "title": "Fetch from SSH Host…",
        "category": "Dev Container FS"
      },
      {
        "command": "devc-vscode.sendFromTree",
        "title": "Send from Local",
        "category": "Dev Container FS",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "devc-vscode.fetchFromTree",
        "title": "Fetch to Local",
        "category": "Dev Container FS",
        "icon": "$(cloud-download)"
      },
      {
        "command": "devc-vscode.newFile",
        "title": "New File",
        "category": "Dev Container FS"
      },
      {
        "command": "devc-vscode.newFolder",
        "title": "New Folder",
        "category": "Dev Container FS"
      },
      {
        "command": "devc-vscode.rename",
        "title": "Rename",
        "category": "Dev Container FS"
      },
      {
        "command": "devc-vscode.delete",
        "title": "Delete",
        "category": "Dev Container FS"
      },
      {
        "command": "devc-vscode.copyPath",
        "title": "Copy Container Path",
        "category": "Dev Container FS"
      },
      {
        "command": "devc-vscode.copyHostContainerPath",
        "title": "Copy Container Path",
        "category": "Dev Container FS"
      },
      {
        "command": "devc-vscode.refreshAgents",
        "title": "Refresh Agents",
        "category": "Dev Container FS",
        "icon": "$(refresh)"
      },
      {
        "command": "devc-vscode.expandAllAgents",
        "title": "Expand All",
        "category": "Dev Container FS",
        "icon": "$(expand-all)"
      },
      {
        "command": "devc-vscode.collapseAllAgents",
        "title": "Collapse All",
        "category": "Dev Container FS",
        "icon": "$(collapse-all)"
      },
      {
        "command": "devc-vscode.focusAgent",
        "title": "Focus Agent",
        "category": "Dev Container FS"
      },
      {
        "command": "devc-vscode.closeAgent",
        "title": "Close Agent",
        "category": "Dev Container FS",
        "icon": "$(trash)"
      },
      {
        "command": "devc-vscode.addAgent",
        "title": "Add Agent",
        "category": "Dev Container FS",
        "icon": "$(add)"
      },
      {
        "command": "devc-vscode.attachAgentGroup",
        "title": "Attach Terminal",
        "category": "Dev Container FS",
        "icon": "$(terminal)"
      },
      {
        "command": "devc-vscode.stopContainer",
        "title": "Stop Container",
        "category": "Dev Container FS",
        "icon": "$(debug-stop)"
      },
      {
        "command": "devc-vscode.downContainer",
        "title": "Down Container",
        "category": "Dev Container FS",
        "icon": "$(trash)"
      },
      {
        "command": "devc-vscode.stopSession",
        "title": "Stop herdr Session",
        "category": "Dev Container FS",
        "icon": "$(debug-stop)"
      },
      {
        "command": "devc-vscode.deleteSession",
        "title": "Delete herdr Session",
        "category": "Dev Container FS",
        "icon": "$(trash)"
      },
      {
        "command": "devc-vscode.askAgent",
        "title": "Ask Agent About Selection",
        "category": "Dev Container FS"
      },
      {
        "command": "devc-vscode.agentReviewSubmit",
        "title": "Ask Agent",
        "category": "Dev Container FS"
      },
      {
        "command": "devc-vscode.agentReviewShowAgent",
        "title": "Show Agent",
        "category": "Dev Container FS",
        "icon": "$(terminal)"
      },
      {
        "command": "devc-vscode.agentReviewDelete",
        "title": "Delete Thread",
        "category": "Dev Container FS",
        "icon": "$(trash)"
      },
      {
        "command": "devc-vscode.agentReviewResend",
        "title": "Resend",
        "category": "Dev Container FS"
      },
      {
        "command": "devc-vscode.openDevcWebTiles",
        "title": "Open devc web Tiles",
        "category": "Dev Container FS",
        "icon": "$(globe)"
      },
      {
        "command": "devc-vscode.restartDevcWeb",
        "title": "Restart devc web",
        "category": "Dev Container FS",
        "icon": "$(debug-restart)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "devc-vscode.refresh",
          "when": "view == devc-vscode.containers",
          "group": "navigation"
        },
        {
          "command": "devc-vscode.showAllFiles",
          "when": "view == devc-vscode.containers && !devc-vscode.showAllFiles",
          "group": "navigation"
        },
        {
          "command": "devc-vscode.showWorkspacesOnly",
          "when": "view == devc-vscode.containers && devc-vscode.showAllFiles",
          "group": "navigation"
        },
        {
          "command": "devc-vscode.refreshAgents",
          "when": "view == devc-vscode.agents",
          "group": "navigation@0"
        },
        {
          "command": "devc-vscode.expandAllAgents",
          "when": "view == devc-vscode.agents",
          "group": "navigation@1"
        },
        {
          "command": "devc-vscode.collapseAllAgents",
          "when": "view == devc-vscode.agents",
          "group": "navigation@2"
        },
        {
          "command": "devc-vscode.addSshHost",
          "when": "view == devc-vscode.containers",
          "group": "navigation"
        },
        {
          "command": "devc-vscode.focusFeatures",
          "when": "view == devc-vscode.containers && config.devc-vscode.featureFolders",
          "group": "1_features"
        },
        {
          "command": "devc-vscode.focusFeatures",
          "when": "view == devc-vscode.agents && config.devc-vscode.featureFolders",
          "group": "1_features@1"
        },
        {
          "command": "devc-vscode.focusActiveAgents",
          "when": "view == devc-vscode.agents && config.devc-vscode.featureFolders",
          "group": "1_features@2"
        },
        {
          "command": "devc-vscode.openFeatureSpace",
          "when": "view == devc-vscode.agents && devc-vscode.hasDocker",
          "group": "1_features@3"
        },
        {
          "command": "devc-vscode.addSpaceFolder",
          "when": "view == devc-vscode.agents && devc-vscode.hasDocker && config.devc-vscode.featureFolders",
          "group": "1_features@4"
        },
        {
          "command": "devc-vscode.openDevcWebTiles",
          "when": "view == devc-vscode.devcWeb",
          "group": "navigation@0"
        },
        {
          "command": "devc-vscode.restartDevcWeb",
          "when": "view == devc-vscode.devcWeb",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "devc-vscode.attachTerminal",
          "when": "view == devc-vscode.containers && viewItem =~ /^(container|sshHost)(\\.attached)?$/",
          "group": "inline"
        },
        {
          "command": "devc-vscode.newFile",
          "when": "view == devc-vscode.containers && viewItem =~ /^(container|sshHost)(\\.attached)?$|^directory(\\.(sync|fetch))?$/",
          "group": "1_new"
        },
        {
          "command": "devc-vscode.newFolder",
          "when": "view == devc-vscode.containers && viewItem =~ /^(container|sshHost)(\\.attached)?$|^directory(\\.(sync|fetch))?$/",
          "group": "1_new@2"
        },
        {
          "command": "devc-vscode.rename",
          "when": "view == devc-vscode.containers && viewItem =~ /^(directory(\\.(sync|fetch))?|file)$/",
          "group": "2_edit"
        },
        {
          "command": "devc-vscode.delete",
          "when": "view == devc-vscode.containers && viewItem =~ /^(directory(\\.(sync|fetch))?|file)$/",
          "group": "2_edit@2"
        },
        {
          "command": "devc-vscode.copyPath",
          "when": "view == devc-vscode.containers && viewItem != sshError",
          "group": "3_copy"
        },
        {
          "command": "devc-vscode.copyHostContainerPath",
          "when": "devc-vscode.hasDocker && view =~ /^(pr|prStatus):github$/ && viewItem =~ /^filechange/",
          "group": "6_copypath@9"
        },
        {
          "command": "devc-vscode.sendFromTree",
          "when": "view == devc-vscode.containers && viewItem == directory.sync",
          "group": "inline@1"
        },
        {
          "command": "devc-vscode.fetchFromTree",
          "when": "view == devc-vscode.containers && viewItem =~ /^directory\\.(sync|fetch)$/",
          "group": "inline@2"
        },
        {
          "command": "devc-vscode.sendFromTree",
          "when": "view == devc-vscode.containers && viewItem == directory.sync",
          "group": "4_sync@1"
        },
        {
          "command": "devc-vscode.fetchFromTree",
          "when": "view == devc-vscode.containers && viewItem =~ /^directory\\.(sync|fetch)$/",
          "group": "4_sync@2"
        },
        {
          "command": "devc-vscode.closeAgent",
          "when": "view == devc-vscode.agents && viewItem == agent",
          "group": "inline"
        },
        {
          "command": "devc-vscode.addAgent",
          "when": "view == devc-vscode.agents && viewItem =~ /^agent(Workspace|Host|Container|Ssh)(\\..*)?$/",
          "group": "inline@9"
        },
        {
          "command": "devc-vscode.attachAgentGroup",
          "when": "view == devc-vscode.agents && viewItem =~ /^agent(Host|Container|Ssh)(\\..*)?$/",
          "group": "inline@1"
        },
        {
          "command": "devc-vscode.stopContainer",
          "when": "view == devc-vscode.agents && viewItem =~ /^agentContainer(\\.attached)?$/ && devc-vscode.canStop",
          "group": "inline@2"
        },
        {
          "command": "devc-vscode.downContainer",
          "when": "view == devc-vscode.agents && viewItem =~ /^agentContainer(\\.attached)?$/ && devc-vscode.canDown",
          "group": "inline@3"
        },
        {
          "command": "devc-vscode.stopSession",
          "when": "view == devc-vscode.agents && viewItem =~ /^agentHost\\.running/",
          "group": "inline@2"
        },
        {
          "command": "devc-vscode.deleteSession",
          "when": "view == devc-vscode.agents && viewItem =~ /^agentHost\\.running(\\.attached)?$/",
          "group": "inline@3"
        },
        {
          "command": "devc-vscode.stopSession",
          "when": "view == devc-vscode.agents && viewItem =~ /^agentSsh\\.running/",
          "group": "inline@2"
        },
        {
          "command": "devc-vscode.deleteSession",
          "when": "view == devc-vscode.agents && viewItem =~ /^agentSsh\\.running/",
          "group": "inline@3"
        }
      ],
      "explorer/context": [
        {
          "command": "devc-vscode.copyHostContainerPath",
          "when": "devc-vscode.hasDocker && resourceScheme == file",
          "group": "6_copypath@9"
        },
        {
          "command": "devc-vscode.openFolderInContainer",
          "when": "explorerResourceIsFolder && resourceScheme != devc-vscode && devc-vscode.canOpenFolder"
        },
        {
          "command": "devc-vscode.sendToSshHost",
          "when": "explorerResourceIsFolder && resourceScheme != devc-vscode && resourceScheme != devc-ssh && devc-vscode.hasSshHosts",
          "group": "devc@1"
        },
        {
          "command": "devc-vscode.fetchFromSshHost",
          "when": "explorerResourceIsFolder && resourceScheme != devc-vscode && resourceScheme != devc-ssh && devc-vscode.hasSshHosts",
          "group": "devc@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "devc-vscode.copyHostContainerPath",
          "when": "devc-vscode.hasDocker && resourceScheme =~ /^(file|review|pr)$/",
          "group": "1_cutcopypaste@9"
        }
      ],
      "editor/context": [
        {
          "command": "devc-vscode.askAgent",
          "when": "devc-vscode.hasDocker && resourceScheme =~ /^(file|git|review|pr)$/",
          "group": "devc@1"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "devc-vscode.agentReviewSubmit",
          "when": "commentController == devc-vscode.agentReview",
          "group": "inline"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "devc-vscode.agentReviewShowAgent",
          "when": "commentController == devc-vscode.agentReview && commentThread =~ /hasAgent/",
          "group": "inline"
        },
        {
          "command": "devc-vscode.agentReviewDelete",
          "when": "commentController == devc-vscode.agentReview",
          "group": "inline"
        }
      ],
      "comments/comment/title": [
        {
          "command": "devc-vscode.agentReviewResend",
          "when": "commentController == devc-vscode.agentReview && comment == failed",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "devc-vscode.showAllFiles",
          "when": "!devc-vscode.showAllFiles"
        },
        {
          "command": "devc-vscode.showWorkspacesOnly",
          "when": "devc-vscode.showAllFiles"
        },
        {
          "command": "devc-vscode.copyHostContainerPath",
          "when": "false"
        },
        {
          "command": "devc-vscode.sendFromTree",
          "when": "false"
        },
        {
          "command": "devc-vscode.fetchFromTree",
          "when": "false"
        },
        {
          "command": "devc-vscode.focusAgent",
          "when": "false"
        },
        {
          "command": "devc-vscode.closeAgent",
          "when": "false"
        },
        {
          "command": "devc-vscode.stopContainer",
          "when": "false"
        },
        {
          "command": "devc-vscode.downContainer",
          "when": "false"
        },
        {
          "command": "devc-vscode.attachTerminal",
          "when": "false"
        },
        {
          "command": "devc-vscode.stopSession",
          "when": "false"
        },
        {
          "command": "devc-vscode.deleteSession",
          "when": "false"
        },
        {
          "command": "devc-vscode.attachAgentGroup",
          "when": "false"
        },
        {
          "command": "devc-vscode.addAgent",
          "when": "false"
        },
        {
          "command": "devc-vscode.openFolderInContainer",
          "when": "devc-vscode.canOpenFolder"
        },
        {
          "command": "devc-vscode.sendToSshHost",
          "when": "devc-vscode.hasSshHosts"
        },
        {
          "command": "devc-vscode.fetchFromSshHost",
          "when": "devc-vscode.hasSshHosts"
        },
        {
          "command": "devc-vscode.askAgent",
          "when": "editorHasSelection"
        },
        {
          "command": "devc-vscode.agentReviewSubmit",
          "when": "false"
        },
        {
          "command": "devc-vscode.agentReviewShowAgent",
          "when": "false"
        },
        {
          "command": "devc-vscode.agentReviewDelete",
          "when": "false"
        },
        {
          "command": "devc-vscode.agentReviewResend",
          "when": "false"
        },
        {
          "command": "devc-vscode.openFeatureSpace",
          "when": "devc-vscode.hasDocker"
        },
        {
          "command": "devc-vscode.addSpaceFolder",
          "when": "devc-vscode.hasDocker && config.devc-vscode.featureFolders"
        },
        {
          "command": "devc-vscode.focusFeatures",
          "when": "config.devc-vscode.featureFolders"
        },
        {
          "command": "devc-vscode.focusActiveAgents",
          "when": "config.devc-vscode.featureFolders"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devc-web",
          "title": "devc web",
          "icon": "resources/devc-web.svg"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "devc-vscode.agents",
          "name": "Agents"
        },
        {
          "id": "devc-vscode.containers",
          "name": "Sandboxes"
        }
      ],
      "devc-web": [
        {
          "id": "devc-vscode.devcWeb",
          "name": "devc web",
          "type": "webview"
        }
      ]
    },
    "keybindings": [
      {
        "command": "devc-vscode.rename",
        "key": "f2",
        "when": "view == devc-vscode.containers && listFocus && !inputFocus"
      },
      {
        "command": "devc-vscode.delete",
        "key": "delete",
        "when": "view == devc-vscode.containers && listFocus && !inputFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "package:dev": "npx vsce package -o devc-vscode-dev.vsix && code --install-extension devc-vscode-dev.vsix",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.138.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "@xterm/headless": "^6.0.0"
  }
}
