{
  "name": "herdr-vscode",
  "displayName": "herdr",
  "description": "herdr sessions, spaces, agents and panes in VS Code.",
  "repository": {
    "type": "git",
    "url": "https://github.com/devc-tools/devc-vscode.git"
  },
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:herdr.sessions",
    "onView:herdr.spaces",
    "onView:herdr.agents",
    "onView:herdr.paneContext",
    "onFileSystem:herdr-container",
    "onFileSystem:herdr-ssh",
    "onFileSystem:herdr-git",
    "onStartupFinished",
    "onWebviewPanel:herdr.tiles"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "herdr",
          "title": "herdr",
          "icon": "resources/herdr.svg"
        }
      ]
    },
    "views": {
      "herdr": [
        {
          "id": "herdr.sessions",
          "name": "Sessions"
        },
        {
          "id": "herdr.spaces",
          "name": "Spaces"
        },
        {
          "id": "herdr.agents",
          "name": "Agents"
        },
        {
          "id": "herdr.paneContext",
          "name": "Pane Context"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "herdr.sessions",
        "contents": "Looking for herdr sessions\u2026"
      },
      {
        "view": "herdr.spaces",
        "contents": "Select a running session in Sessions.",
        "when": "!herdr.sessionSelected"
      },
      {
        "view": "herdr.spaces",
        "contents": "This session has no spaces.\n[New Space](command:herdr.newSpace)",
        "when": "herdr.sessionSelected"
      },
      {
        "view": "herdr.agents",
        "contents": "No agents.",
        "when": "herdr.agentsFilter == all || !herdr.agentsFilter"
      },
      {
        "view": "herdr.agents",
        "contents": "No agents match this filter.",
        "when": "herdr.agentsFilter && herdr.agentsFilter != all"
      }
    ],
    "commands": [
      {
        "command": "herdr.refresh",
        "title": "Refresh",
        "category": "herdr",
        "icon": "$(refresh)"
      },
      {
        "command": "herdr.openTab",
        "title": "Open herdr Tab",
        "category": "herdr"
      },
      {
        "command": "herdr.openPaneTab",
        "title": "Open in herdr Tab",
        "category": "herdr"
      },
      {
        "command": "herdr.addToLayout",
        "title": "Add to Layout",
        "category": "herdr"
      },
      {
        "command": "herdr.newLayout",
        "title": "New Layout",
        "category": "herdr",
        "icon": "$(new-file)"
      },
      {
        "command": "herdr.openLayout",
        "title": "Open Layout…",
        "category": "herdr"
      },
      {
        "command": "herdr.renameLayout",
        "title": "Rename Layout…",
        "category": "herdr"
      },
      {
        "command": "herdr.deleteLayout",
        "title": "Delete Layout…",
        "category": "herdr"
      },
      {
        "command": "herdr.focusPane",
        "title": "Focus in herdr TUI",
        "category": "herdr"
      },
      {
        "command": "herdr.agents.showAll",
        "title": "Show All",
        "category": "herdr",
        "icon": "$(list-flat)"
      },
      {
        "command": "herdr.agents.showBlocked",
        "title": "Show Blocked",
        "category": "herdr",
        "icon": "$(warning)"
      },
      {
        "command": "herdr.agents.showWorking",
        "title": "Show Working",
        "category": "herdr",
        "icon": "$(sync)"
      },
      {
        "command": "herdr.paneContext.pin",
        "title": "Pin",
        "category": "herdr",
        "icon": "$(pin)"
      },
      {
        "command": "herdr.paneContext.unpin",
        "title": "Unpin",
        "category": "herdr",
        "icon": "$(pinned)"
      },
      {
        "command": "herdr.paneContext.refresh",
        "title": "Refresh",
        "category": "herdr",
        "icon": "$(refresh)"
      },
      {
        "command": "herdr.paneContext.addToWorkspace",
        "title": "Add to Workspace",
        "category": "herdr",
        "icon": "$(root-folder-opened)"
      },
      {
        "command": "herdr.paneContext.splitPane",
        "title": "Split Pane Here",
        "category": "herdr",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "herdr.paneContext.showPane",
        "title": "Show Pane",
        "category": "herdr",
        "icon": "$(window)"
      },
      {
        "command": "herdr.paneContext.openChanges",
        "title": "Open Changes",
        "category": "herdr",
        "icon": "$(diff)"
      },
      {
        "command": "herdr.paneContext.newFile",
        "title": "New File…",
        "category": "herdr",
        "icon": "$(new-file)"
      },
      {
        "command": "herdr.paneContext.newFolder",
        "title": "New Folder…",
        "category": "herdr",
        "icon": "$(new-folder)"
      },
      {
        "command": "herdr.paneContext.rename",
        "title": "Rename…",
        "category": "herdr"
      },
      {
        "command": "herdr.paneContext.delete",
        "title": "Delete…",
        "category": "herdr"
      },
      {
        "command": "herdr.startSession",
        "title": "Start Session",
        "category": "herdr",
        "icon": "$(play)"
      },
      {
        "command": "herdr.stopSession",
        "title": "Stop Session",
        "category": "herdr",
        "icon": "$(debug-stop)"
      },
      {
        "command": "herdr.newSpace",
        "title": "New Space",
        "category": "herdr",
        "icon": "$(add)"
      },
      {
        "command": "herdr.newTab",
        "title": "New Tab",
        "category": "herdr",
        "icon": "$(add)"
      },
      {
        "command": "herdr.splitRight",
        "title": "Split Right",
        "category": "herdr",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "herdr.splitDown",
        "title": "Split Down",
        "category": "herdr",
        "icon": "$(split-vertical)"
      },
      {
        "command": "herdr.cancelPlacement",
        "title": "Cancel Placing Pane",
        "category": "herdr"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "herdr.newSpace",
          "when": "view == herdr.spaces && herdr.sessionSelected",
          "group": "navigation@1"
        },
        {
          "command": "herdr.newLayout",
          "when": "view == herdr.sessions",
          "group": "navigation@1"
        },
        {
          "command": "herdr.refresh",
          "when": "view == herdr.sessions",
          "group": "navigation@2"
        },
        {
          "command": "herdr.agents.showAll",
          "when": "view == herdr.agents && herdr.agentsFilter != all",
          "group": "navigation@1"
        },
        {
          "command": "herdr.agents.showBlocked",
          "when": "view == herdr.agents",
          "group": "navigation@2"
        },
        {
          "command": "herdr.agents.showWorking",
          "when": "view == herdr.agents",
          "group": "navigation@3"
        },
        {
          "command": "herdr.paneContext.pin",
          "when": "view == herdr.paneContext && !herdr.paneContextPinned",
          "group": "navigation@1"
        },
        {
          "command": "herdr.paneContext.unpin",
          "when": "view == herdr.paneContext && herdr.paneContextPinned",
          "group": "navigation@1"
        },
        {
          "command": "herdr.paneContext.refresh",
          "when": "view == herdr.paneContext",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "herdr.startSession",
          "when": "view == herdr.sessions && viewItem == 'herdr.session.stopped host'",
          "group": "inline@1"
        },
        {
          "command": "herdr.stopSession",
          "when": "view == herdr.sessions && viewItem == 'herdr.session.running host'",
          "group": "inline@1"
        },
        {
          "command": "herdr.newTab",
          "when": "view == herdr.spaces && viewItem == herdr.space",
          "group": "inline@1"
        },
        {
          "command": "herdr.splitRight",
          "when": "view == herdr.spaces && viewItem =~ /^herdr\\.(tab|pane\\.(agent|shell))$/",
          "group": "inline@1"
        },
        {
          "command": "herdr.splitDown",
          "when": "view == herdr.spaces && viewItem =~ /^herdr\\.(tab|pane\\.(agent|shell))$/",
          "group": "inline@2"
        },
        {
          "command": "herdr.addToLayout",
          "when": "view =~ /^herdr\\.(spaces|agents|paneContext)$/ && viewItem =~ /^herdr\\.pane\\.(agent|shell)$/",
          "group": "navigation@1"
        },
        {
          "command": "herdr.openPaneTab",
          "when": "view =~ /^herdr\\.(spaces|agents|paneContext)$/ && viewItem =~ /^herdr\\.pane\\.(agent|shell)$/",
          "group": "navigation@2"
        },
        {
          "command": "herdr.focusPane",
          "when": "view =~ /^herdr\\.(spaces|agents|paneContext)$/ && viewItem =~ /^herdr\\.pane\\.(agent|shell)$/",
          "group": "navigation@3"
        },
        {
          "command": "herdr.paneContext.addToWorkspace",
          "when": "view == herdr.paneContext && viewItem =~ /^herdr\\.paneContext\\.root.* addable/",
          "group": "inline@1"
        },
        {
          "command": "herdr.paneContext.splitPane",
          "when": "view == herdr.paneContext && viewItem =~ /^herdr\\.paneContext\\.root/",
          "group": "inline@2"
        },
        {
          "command": "herdr.paneContext.showPane",
          "when": "view == herdr.paneContext && viewItem =~ /^herdr\\.paneContext\\.root.* showable/",
          "group": "inline@3"
        },
        {
          "command": "herdr.paneContext.openChanges",
          "when": "view == herdr.paneContext && viewItem == herdr.paneContext.change",
          "group": "inline@1"
        },
        {
          "command": "herdr.paneContext.newFile",
          "when": "view == herdr.paneContext && viewItem =~ /^herdr\\.paneContext\\.(files|folder)$/",
          "group": "inline@1"
        },
        {
          "command": "herdr.paneContext.newFolder",
          "when": "view == herdr.paneContext && viewItem =~ /^herdr\\.paneContext\\.(files|folder)$/",
          "group": "inline@2"
        },
        {
          "command": "herdr.paneContext.newFile",
          "when": "view == herdr.paneContext && viewItem =~ /^herdr\\.paneContext\\.(file|folder)$/",
          "group": "1_new@1"
        },
        {
          "command": "herdr.paneContext.newFolder",
          "when": "view == herdr.paneContext && viewItem =~ /^herdr\\.paneContext\\.(file|folder)$/",
          "group": "1_new@2"
        },
        {
          "command": "herdr.paneContext.rename",
          "when": "view == herdr.paneContext && viewItem =~ /^herdr\\.paneContext\\.(file|folder)$/",
          "group": "2_edit@1"
        },
        {
          "command": "herdr.paneContext.delete",
          "when": "view == herdr.paneContext && viewItem =~ /^herdr\\.paneContext\\.(file|folder)$/",
          "group": "2_edit@2"
        }
      ],
      "commandPalette": [
        {
          "command": "herdr.openTab",
          "when": "false"
        },
        {
          "command": "herdr.openPaneTab",
          "when": "false"
        },
        {
          "command": "herdr.focusPane",
          "when": "false"
        },
        {
          "command": "herdr.addToLayout",
          "when": "false"
        },
        {
          "command": "herdr.paneContext.addToWorkspace",
          "when": "false"
        },
        {
          "command": "herdr.paneContext.splitPane",
          "when": "false"
        },
        {
          "command": "herdr.paneContext.showPane",
          "when": "false"
        },
        {
          "command": "herdr.paneContext.openChanges",
          "when": "false"
        },
        {
          "command": "herdr.paneContext.newFile",
          "when": "false"
        },
        {
          "command": "herdr.paneContext.newFolder",
          "when": "false"
        },
        {
          "command": "herdr.paneContext.rename",
          "when": "false"
        },
        {
          "command": "herdr.paneContext.delete",
          "when": "false"
        },
        {
          "command": "herdr.startSession",
          "when": "false"
        },
        {
          "command": "herdr.stopSession",
          "when": "false"
        },
        {
          "command": "herdr.newSpace",
          "when": "herdr.sessionSelected"
        },
        {
          "command": "herdr.newTab",
          "when": "false"
        },
        {
          "command": "herdr.splitRight",
          "when": "false"
        },
        {
          "command": "herdr.splitDown",
          "when": "false"
        },
        {
          "command": "herdr.cancelPlacement",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "herdr.cancelPlacement",
        "key": "escape",
        "when": "herdr.placingPane"
      }
    ],
    "configuration": {
      "title": "herdr",
      "properties": {
        "herdr.sshHosts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "default": [],
          "scope": "application",
          "markdownDescription": "ssh aliases from `~/.ssh/config` whose herdr sessions are shown."
        },
        "herdr.sshPath": {
          "type": "string",
          "default": "ssh",
          "scope": "application",
          "description": "ssh client."
        },
        "herdr.dockerPath": {
          "type": "string",
          "default": "docker",
          "scope": "application",
          "description": "Docker CLI."
        },
        "herdr.showStoppedSessions": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "List stopped herdr sessions on SSH hosts and in dev containers too. This machine's are always listed."
        },
        "herdr.openPaneIn": {
          "type": "string",
          "enum": [
            "layout",
            "herdr"
          ],
          "enumDescriptions": [
            "Add the pane to a Layout tab.",
            "Open the pane's herdr tab."
          ],
          "default": "layout",
          "scope": "window",
          "description": "What clicking a pane or agent row does."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p ./ && tsc -p src/webview",
    "bundle": "node esbuild.mjs",
    "build": "npm run compile && npm run bundle",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "pretest": "npm run build && npm run lint",
    "test": "vscode-test",
    "package:dev": "vsce package --no-dependencies -o herdr-vscode-dev.vsix && code --install-extension herdr-vscode-dev.vsix"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.138.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "0.28.2",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "golden-layout": "2.6.0"
  }
}
