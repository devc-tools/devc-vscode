{
  "name": "herdr-vscode",
  "displayName": "herdr",
  "description": "herdr sessions, spaces, agents and panes in VS Code.",
  "repository": {
    "type": "git",
    "url": "https://github.com/devc-tools/devc-vscode.git"
  },
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:herdr.sessions",
    "onView:herdr.spaces",
    "onView:herdr.agents",
    "onStartupFinished",
    "onWebviewPanel:herdr.tiles"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "herdr",
          "title": "herdr",
          "icon": "resources/herdr.svg"
        }
      ]
    },
    "views": {
      "herdr": [
        {
          "id": "herdr.sessions",
          "name": "Sessions"
        },
        {
          "id": "herdr.spaces",
          "name": "Spaces"
        },
        {
          "id": "herdr.agents",
          "name": "Agents"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "herdr.sessions",
        "contents": "Looking for herdr sessions\u2026"
      },
      {
        "view": "herdr.spaces",
        "contents": "Select a running session in Sessions.",
        "when": "!herdr.sessionSelected"
      },
      {
        "view": "herdr.spaces",
        "contents": "This session has no spaces.",
        "when": "herdr.sessionSelected"
      },
      {
        "view": "herdr.agents",
        "contents": "No agents.",
        "when": "herdr.agentsFilter == all || !herdr.agentsFilter"
      },
      {
        "view": "herdr.agents",
        "contents": "No agents match this filter.",
        "when": "herdr.agentsFilter && herdr.agentsFilter != all"
      }
    ],
    "commands": [
      {
        "command": "herdr.refresh",
        "title": "Refresh",
        "category": "herdr",
        "icon": "$(refresh)"
      },
      {
        "command": "herdr.openTab",
        "title": "Open herdr Tab",
        "category": "herdr"
      },
      {
        "command": "herdr.openPaneTab",
        "title": "Open in herdr Tab",
        "category": "herdr"
      },
      {
        "command": "herdr.focusPane",
        "title": "Focus Pane in herdr",
        "category": "herdr"
      },
      {
        "command": "herdr.agents.showAll",
        "title": "Show All",
        "category": "herdr",
        "icon": "$(list-flat)"
      },
      {
        "command": "herdr.agents.showBlocked",
        "title": "Show Blocked",
        "category": "herdr",
        "icon": "$(warning)"
      },
      {
        "command": "herdr.agents.showWorking",
        "title": "Show Working",
        "category": "herdr",
        "icon": "$(sync)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "herdr.refresh",
          "when": "view == herdr.sessions",
          "group": "navigation"
        },
        {
          "command": "herdr.agents.showAll",
          "when": "view == herdr.agents && herdr.agentsFilter != all",
          "group": "navigation@1"
        },
        {
          "command": "herdr.agents.showBlocked",
          "when": "view == herdr.agents",
          "group": "navigation@2"
        },
        {
          "command": "herdr.agents.showWorking",
          "when": "view == herdr.agents",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "herdr.openPaneTab",
          "when": "view =~ /^herdr\\.(spaces|agents)$/ && viewItem =~ /^herdr\\.pane\\.(agent|shell)$/",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "herdr.openTab",
          "when": "false"
        },
        {
          "command": "herdr.openPaneTab",
          "when": "false"
        },
        {
          "command": "herdr.focusPane",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "herdr",
      "properties": {
        "herdr.sshHosts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "default": [],
          "scope": "application",
          "markdownDescription": "ssh aliases from `~/.ssh/config` whose herdr sessions are shown."
        },
        "herdr.sshPath": {
          "type": "string",
          "default": "ssh",
          "scope": "application",
          "description": "ssh client."
        },
        "herdr.dockerPath": {
          "type": "string",
          "default": "docker",
          "scope": "application",
          "description": "Docker CLI."
        },
        "herdr.showStoppedSessions": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "List stopped herdr sessions too."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p ./ && tsc -p src/webview",
    "bundle": "node esbuild.mjs",
    "build": "npm run compile && npm run bundle",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "pretest": "npm run build && npm run lint",
    "test": "vscode-test",
    "package:dev": "vsce package --no-dependencies -o herdr-vscode-dev.vsix && code --install-extension herdr-vscode-dev.vsix"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.138.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "0.28.2",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "golden-layout": "2.6.0"
  }
}
