{
  "name": "herdr-vscode",
  "displayName": "herdr",
  "publisher": "devc-tools",
  "description": "herdr sessions, spaces, agents and panes in VS Code.",
  "repository": {
    "type": "git",
    "url": "https://github.com/devc-tools/devc-vscode.git"
  },
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:herdr.spaces",
    "onView:herdr.agents",
    "onView:herdr.paneContext",
    "onFileSystem:herdr-container",
    "onFileSystem:herdr-ssh",
    "onFileSystem:herdr-git",
    "onStartupFinished",
    "onWebviewPanel:herdr.tiles"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "herdr",
          "title": "herdr",
          "icon": "resources/herdr.svg"
        }
      ]
    },
    "views": {
      "herdr": [
        {
          "id": "herdr.spaces",
          "name": "Spaces"
        },
        {
          "id": "herdr.agents",
          "name": "Agents"
        },
        {
          "id": "herdr.paneContext",
          "name": "Active Pane"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "herdr.spaces",
        "contents": "No session selected.\n[Select Session](command:herdr.sessions.switch)",
        "when": "!herdr.sessionSelected"
      },
      {
        "view": "herdr.spaces",
        "contents": "This session has no spaces.\n[New Space](command:herdr.newSpace)",
        "when": "herdr.sessionSelected"
      },
      {
        "view": "herdr.agents",
        "contents": "No session selected.\n[Select Session](command:herdr.sessions.switch)",
        "when": "herdr.agentsScope == session && !herdr.sessionSelected"
      },
      {
        "view": "herdr.agents",
        "contents": "No agents.",
        "when": "(herdr.agentsScope != session || herdr.sessionSelected) && (herdr.agentsFilter == all || !herdr.agentsFilter)"
      },
      {
        "view": "herdr.agents",
        "contents": "No agents match this filter.",
        "when": "(herdr.agentsScope != session || herdr.sessionSelected) && herdr.agentsFilter && herdr.agentsFilter != all"
      }
    ],
    "commands": [
      {
        "command": "herdr.refresh",
        "title": "Refresh",
        "category": "herdr",
        "icon": "$(refresh)"
      },
      {
        "command": "herdr.openSpace",
        "title": "Open herdr Space",
        "category": "herdr"
      },
      {
        "command": "herdr.openTab",
        "title": "Open herdr Tab",
        "category": "herdr"
      },
      {
        "command": "herdr.openPaneTab",
        "title": "Open in herdr Space",
        "category": "herdr"
      },
      {
        "command": "herdr.focusPane",
        "title": "Focus in herdr TUI",
        "category": "herdr"
      },
      {
        "command": "herdr.agents.showAll",
        "title": "Show All",
        "category": "herdr",
        "icon": "$(list-flat)"
      },
      {
        "command": "herdr.agents.showBlocked",
        "title": "Show Blocked",
        "category": "herdr",
        "icon": "$(warning)"
      },
      {
        "command": "herdr.agents.showWorking",
        "title": "Show Working",
        "category": "herdr",
        "icon": "$(sync)"
      },
      {
        "command": "herdr.agents.showDone",
        "title": "Show Done",
        "category": "herdr",
        "icon": "$(pass)"
      },
      {
        "command": "herdr.agents.filter",
        "title": "Filter Agents…",
        "category": "herdr",
        "icon": "$(filter)"
      },
      {
        "command": "herdr.agents.scopeSession",
        "title": "Show Only the Selected Session",
        "category": "herdr",
        "icon": "$(globe)"
      },
      {
        "command": "herdr.agents.scopeAll",
        "title": "Show All Sessions",
        "category": "herdr",
        "icon": "$(target)"
      },
      {
        "command": "herdr.paneContext.refresh",
        "title": "Refresh",
        "category": "herdr",
        "icon": "$(refresh)"
      },
      {
        "command": "herdr.paneContext.addToWorkspace",
        "title": "Add to Workspace",
        "category": "herdr",
        "icon": "$(root-folder-opened)"
      },
      {
        "command": "herdr.paneContext.showPane",
        "title": "Show Pane",
        "category": "herdr",
        "icon": "$(window)"
      },
      {
        "command": "herdr.paneContext.openChanges",
        "title": "Open Changes",
        "category": "herdr",
        "icon": "$(diff)"
      },
      {
        "command": "herdr.paneContext.openFile",
        "title": "Open File",
        "category": "herdr",
        "icon": "$(go-to-file)"
      },
      {
        "command": "herdr.paneContext.showPaneFiles",
        "title": "Show Only This Pane's Files",
        "category": "herdr",
        "icon": "$(filter)"
      },
      {
        "command": "herdr.paneContext.showAllFiles",
        "title": "Show All Files",
        "category": "herdr",
        "icon": "$(filter-filled)"
      },
      {
        "command": "herdr.paneContext.openSourceControl",
        "title": "Open in Source Control",
        "category": "herdr",
        "icon": "$(source-control)"
      },
      {
        "command": "herdr.paneContext.openTerminal",
        "title": "Terminal Here",
        "category": "herdr",
        "icon": "$(terminal)"
      },
      {
        "command": "herdr.paneContext.newFile",
        "title": "New File…",
        "category": "herdr",
        "icon": "$(new-file)"
      },
      {
        "command": "herdr.paneContext.newFolder",
        "title": "New Folder…",
        "category": "herdr",
        "icon": "$(new-folder)"
      },
      {
        "command": "herdr.paneContext.rename",
        "title": "Rename…",
        "category": "herdr"
      },
      {
        "command": "herdr.paneContext.delete",
        "title": "Delete…",
        "category": "herdr"
      },
      {
        "command": "herdr.newSpace",
        "title": "New Space",
        "category": "herdr",
        "icon": "$(add)"
      },
      {
        "command": "herdr.closeSpace",
        "title": "Close Space",
        "category": "herdr",
        "icon": "$(trash)"
      },
      {
        "command": "herdr.closeTab",
        "title": "Close Tab",
        "category": "herdr",
        "icon": "$(trash)"
      },
      {
        "command": "herdr.closePane",
        "title": "Close Pane",
        "category": "herdr",
        "icon": "$(trash)"
      },
      {
        "command": "herdr.askAgent",
        "title": "Ask herdr Agent About Selection",
        "category": "herdr"
      },
      {
        "command": "herdr.agentReview.submit",
        "title": "Ask Agent",
        "category": "herdr"
      },
      {
        "command": "herdr.agentReview.showAgent",
        "title": "Show Agent",
        "category": "herdr",
        "icon": "$(terminal)"
      },
      {
        "command": "herdr.agentReview.delete",
        "title": "Delete Thread",
        "category": "herdr",
        "icon": "$(trash)"
      },
      {
        "command": "herdr.agentReview.resend",
        "title": "Resend",
        "category": "herdr"
      },
      {
        "command": "herdr.tile.splitRight",
        "title": "Split Right",
        "category": "herdr"
      },
      {
        "command": "herdr.tile.splitDown",
        "title": "Split Down",
        "category": "herdr"
      },
      {
        "command": "herdr.tile.zoom",
        "title": "Zoom",
        "category": "herdr"
      },
      {
        "command": "herdr.tile.unzoom",
        "title": "Unzoom",
        "category": "herdr"
      },
      {
        "command": "herdr.tile.close",
        "title": "Close Pane",
        "category": "herdr"
      },
      {
        "command": "herdr.sessions.switch",
        "title": "Switch Session",
        "category": "herdr",
        "icon": "$(arrow-swap)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "herdr.sessions.switch",
          "when": "view == herdr.spaces",
          "group": "navigation@0"
        },
        {
          "command": "herdr.paneContext.showPane",
          "when": "view == herdr.paneContext && herdr.paneContext.following",
          "group": "navigation@0"
        },
        {
          "command": "herdr.newSpace",
          "when": "view == herdr.spaces && herdr.sessionSelected",
          "group": "navigation@1"
        },
        {
          "command": "herdr.agents.scopeSession",
          "when": "view == herdr.agents && herdr.agentsScope != session",
          "group": "navigation@1"
        },
        {
          "command": "herdr.agents.scopeAll",
          "when": "view == herdr.agents && herdr.agentsScope == session",
          "group": "navigation@1"
        },
        {
          "command": "herdr.agents.filter",
          "when": "view == herdr.agents",
          "group": "navigation@2"
        },
        {
          "command": "herdr.agents.showAll",
          "when": "view == herdr.agents && herdr.agentsFilter != all",
          "group": "navigation@3"
        },
        {
          "command": "herdr.paneContext.showPaneFiles",
          "when": "view == herdr.paneContext && !herdr.paneContext.paneFilesOnly",
          "group": "navigation@2"
        },
        {
          "command": "herdr.paneContext.showAllFiles",
          "when": "view == herdr.paneContext && herdr.paneContext.paneFilesOnly",
          "group": "navigation@2"
        },
        {
          "command": "herdr.paneContext.refresh",
          "when": "view == herdr.paneContext",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "herdr.closeSpace",
          "when": "view == herdr.spaces && viewItem == herdr.space",
          "group": "inline@1"
        },
        {
          "command": "herdr.closeTab",
          "when": "view == herdr.spaces && viewItem == herdr.tab",
          "group": "inline@1"
        },
        {
          "command": "herdr.closePane",
          "when": "view =~ /^herdr\\.(spaces|agents)$/ && viewItem =~ /^herdr\\.pane\\.(agent|shell)$/",
          "group": "inline@1"
        },
        {
          "command": "herdr.openPaneTab",
          "when": "view =~ /^herdr\\.(spaces|agents|paneContext)$/ && viewItem =~ /^herdr\\.pane\\.(agent|shell)$/",
          "group": "navigation@2"
        },
        {
          "command": "herdr.focusPane",
          "when": "view =~ /^herdr\\.(spaces|agents|paneContext)$/ && viewItem =~ /^herdr\\.pane\\.(agent|shell)$/",
          "group": "navigation@3"
        },
        {
          "command": "herdr.paneContext.addToWorkspace",
          "when": "view == herdr.paneContext && viewItem =~ /^herdr\\.paneContext\\.root.* addable/",
          "group": "inline@1"
        },
        {
          "command": "herdr.paneContext.openSourceControl",
          "when": "view == herdr.paneContext && viewItem =~ /^herdr\\.paneContext\\.root.* scm/",
          "group": "inline@2"
        },
        {
          "command": "herdr.paneContext.openTerminal",
          "when": "view == herdr.paneContext && viewItem =~ /^herdr\\.paneContext\\.root.* terminal/",
          "group": "inline@3"
        },
        {
          "command": "herdr.paneContext.openFile",
          "when": "view == herdr.paneContext && viewItem =~ /^herdr\\.paneContext\\.(change|commitFile)$/",
          "group": "inline@1"
        },
        {
          "command": "herdr.paneContext.newFile",
          "when": "view == herdr.paneContext && viewItem =~ /^herdr\\.paneContext\\.(files|folder)$/",
          "group": "inline@1"
        },
        {
          "command": "herdr.paneContext.newFolder",
          "when": "view == herdr.paneContext && viewItem =~ /^herdr\\.paneContext\\.(files|folder)$/",
          "group": "inline@2"
        },
        {
          "command": "herdr.paneContext.newFile",
          "when": "view == herdr.paneContext && viewItem =~ /^herdr\\.paneContext\\.(file|folder)$/",
          "group": "1_new@1"
        },
        {
          "command": "herdr.paneContext.newFolder",
          "when": "view == herdr.paneContext && viewItem =~ /^herdr\\.paneContext\\.(file|folder)$/",
          "group": "1_new@2"
        },
        {
          "command": "herdr.paneContext.rename",
          "when": "view == herdr.paneContext && viewItem =~ /^herdr\\.paneContext\\.(file|folder)$/",
          "group": "2_edit@1"
        },
        {
          "command": "herdr.paneContext.delete",
          "when": "view == herdr.paneContext && viewItem =~ /^herdr\\.paneContext\\.(file|folder)$/",
          "group": "2_edit@2"
        }
      ],
      "editor/context": [
        {
          "command": "herdr.askAgent",
          "when": "herdr.hasAgents && resourceScheme =~ /^(file|git|review|pr|herdr-container|herdr-ssh|herdr-git)$/",
          "group": "herdr@1"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "herdr.agentReview.submit",
          "when": "commentController == herdr.agentReview"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "herdr.agentReview.showAgent",
          "when": "commentController == herdr.agentReview && commentThread =~ /hasAgent/",
          "group": "inline"
        },
        {
          "command": "herdr.agentReview.delete",
          "when": "commentController == herdr.agentReview",
          "group": "inline"
        }
      ],
      "comments/comment/title": [
        {
          "command": "herdr.agentReview.resend",
          "when": "commentController == herdr.agentReview && comment == failed",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "herdr.openSpace",
          "when": "false"
        },
        {
          "command": "herdr.openTab",
          "when": "false"
        },
        {
          "command": "herdr.openPaneTab",
          "when": "false"
        },
        {
          "command": "herdr.focusPane",
          "when": "false"
        },
        {
          "command": "herdr.paneContext.addToWorkspace",
          "when": "false"
        },
        {
          "command": "herdr.paneContext.showPane",
          "when": "false"
        },
        {
          "command": "herdr.paneContext.openChanges",
          "when": "false"
        },
        {
          "command": "herdr.paneContext.openFile",
          "when": "false"
        },
        {
          "command": "herdr.paneContext.showPaneFiles",
          "when": "false"
        },
        {
          "command": "herdr.paneContext.showAllFiles",
          "when": "false"
        },
        {
          "command": "herdr.paneContext.openSourceControl",
          "when": "false"
        },
        {
          "command": "herdr.paneContext.openTerminal",
          "when": "false"
        },
        {
          "command": "herdr.paneContext.newFile",
          "when": "false"
        },
        {
          "command": "herdr.paneContext.newFolder",
          "when": "false"
        },
        {
          "command": "herdr.paneContext.rename",
          "when": "false"
        },
        {
          "command": "herdr.paneContext.delete",
          "when": "false"
        },
        {
          "command": "herdr.newSpace",
          "when": "herdr.sessionSelected"
        },
        {
          "command": "herdr.askAgent",
          "when": "herdr.hasAgents && editorIsOpen"
        },
        {
          "command": "herdr.agentReview.submit",
          "when": "false"
        },
        {
          "command": "herdr.agentReview.showAgent",
          "when": "false"
        },
        {
          "command": "herdr.agentReview.delete",
          "when": "false"
        },
        {
          "command": "herdr.agentReview.resend",
          "when": "false"
        },
        {
          "command": "herdr.tile.splitRight",
          "when": "false"
        },
        {
          "command": "herdr.tile.splitDown",
          "when": "false"
        },
        {
          "command": "herdr.tile.zoom",
          "when": "false"
        },
        {
          "command": "herdr.tile.unzoom",
          "when": "false"
        },
        {
          "command": "herdr.tile.close",
          "when": "false"
        },
        {
          "command": "herdr.closeSpace",
          "when": "false"
        },
        {
          "command": "herdr.closeTab",
          "when": "false"
        },
        {
          "command": "herdr.closePane",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "herdr.tile.splitRight",
          "when": "webviewId == 'herdr.tiles' && webviewSection == 'tile'",
          "group": "1_split@1"
        },
        {
          "command": "herdr.tile.splitDown",
          "when": "webviewId == 'herdr.tiles' && webviewSection == 'tile'",
          "group": "1_split@2"
        },
        {
          "command": "herdr.tile.zoom",
          "when": "webviewId == 'herdr.tiles' && webviewSection == 'tile' && !zoomed",
          "group": "2_view@1"
        },
        {
          "command": "herdr.tile.unzoom",
          "when": "webviewId == 'herdr.tiles' && webviewSection == 'tile' && zoomed",
          "group": "2_view@1"
        },
        {
          "command": "herdr.tile.close",
          "when": "webviewId == 'herdr.tiles' && webviewSection == 'tile'",
          "group": "3_close@1"
        }
      ]
    },
    "icons": {
      "herdr-agent-claude": {
        "description": "Claude Code",
        "default": {
          "fontPath": "resources/agent-icons.woff",
          "fontCharacter": "\\E001"
        }
      },
      "herdr-agent-copilot": {
        "description": "GitHub Copilot",
        "default": {
          "fontPath": "resources/agent-icons.woff",
          "fontCharacter": "\\E002"
        }
      },
      "herdr-agent-pi": {
        "description": "pi",
        "default": {
          "fontPath": "resources/agent-icons.woff",
          "fontCharacter": "\\E003"
        }
      },
      "herdr-agent-opencode": {
        "description": "OpenCode",
        "default": {
          "fontPath": "resources/agent-icons.woff",
          "fontCharacter": "\\E004"
        }
      }
    },
    "resourceLabelFormatters": [
      {
        "scheme": "herdr-container",
        "formatting": {
          "label": "devc: ${query.label} › ${path}",
          "separator": "/"
        }
      },
      {
        "scheme": "herdr-ssh",
        "formatting": {
          "label": "ssh: ${authority} › ${path}",
          "separator": "/"
        }
      }
    ],
    "configuration": {
      "title": "herdr",
      "properties": {
        "herdr.sshHosts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "default": [],
          "scope": "application",
          "markdownDescription": "ssh aliases from `~/.ssh/config` whose herdr sessions are shown."
        },
        "herdr.sshPath": {
          "type": "string",
          "default": "ssh",
          "scope": "application",
          "description": "ssh client."
        },
        "herdr.dockerPath": {
          "type": "string",
          "default": "docker",
          "scope": "application",
          "description": "Docker CLI."
        },
        "herdr.showStoppedSessions": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "List stopped herdr sessions on SSH hosts and in dev containers too. This machine's are always listed."
        },
        "herdr.useHerdrSidebarConfig": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "Lay out Spaces and Agents rows from `[ui.sidebar.*]` in this machine's herdr `config.toml`. Off: the built-in rows."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p ./ && tsc -p src/webview",
    "bundle": "node esbuild.mjs",
    "build": "npm run compile && npm run bundle",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "pretest": "npm run build && npm run lint",
    "test": "vscode-test",
    "package:dev": "vsce package --no-dependencies -o herdr-vscode-dev.vsix && code --install-extension herdr-vscode-dev.vsix"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.138.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "0.28.2",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "golden-layout": "2.6.0",
    "smol-toml": "1.9.1"
  }
}
